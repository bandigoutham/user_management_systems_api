APP_NAME=User Management System API

# Change these values for your local MySQL installation.
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/user_management_db

# Replace this with a long random secret before real deployment.
JWT_SECRET_KEY=replace-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
